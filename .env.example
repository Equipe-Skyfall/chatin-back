# --- Supabase / Postgres ---
SUPABASE_DB_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=fontes-raw   # not needed in v1 - uploads deferred

# --- Auth (validates JWTs issued by the external user-service) ---
# In production this must match the auth service's real secret exactly - a
# mismatched/invalid signature is always rejected. Outside production
# (ENV != "production", see below), a token that fails verification against
# this JWT_SECRET is still accepted (unverified) so real tokens from the
# external auth service can be used for local testing too.
JWT_SECRET=<shared-hs256-secret>
JWT_ALGORITHM=HS256

# --- AI provider (strategy pattern - "adk" or "gemini", see app/config.py) ---
AI_PROVIDER=adk
GEMINI_API_KEY=<key>
GEMINI_MODEL_CONTEUDO=gemini-2.5-flash
GEMINI_MODEL_QUESTIONARIO=gemini-2.5-flash
GEMINI_MODEL_SEARCH=gemini-2.5-flash
GEMINI_MODEL_AGENTE=gemini-2.5-flash
GEMINI_MODEL_PROFESSOR=gemini-2.5-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# --- Content generation tuning ---
QUESTIONARIO_POOL_SIZE=12
TENTATIVA_NUM_QUESTOES=5
PONTUACAO_MINIMA_APROVACAO=60
AGENTE_MAX_ITERACOES=8

# --- Chat memory cache (Redis) - optional; unset disables the cache and the
# student chat always reloads history from Postgres. `redis://redis:6379/0`
# is the docker-compose service name; use `redis://localhost:6379/0` running
# outside docker. ---
REDIS_URL=redis://redis:6379/0
MEMORIA_JANELA_MENSAGENS=20
MEMORIA_LONGO_PRAZO_LIMITE=3

# --- App ---
# "local" or "production" - defaults to "production" (fail-safe) if unset.
# Only "local" gets the JWT signature-fallback described above.
ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
